#!/bin/bash
# AI Office: builds and packs the macOS app as "AI Office.app".
#
#   scripts/package-ai-office   -> dist/AI-Office-macos-<arch>.zip
#
# A build from source on purpose: without HERDR_APP_RELEASE the app never
# checks Herdr's release server for updates and never sends usage reports.
# Signed ad hoc; Gatekeeper asks once on first open.
set -euo pipefail
cd "$(dirname "$0")/.."

version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
arch=$(uname -m)
cargo build --release --locked

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
app="$work/AI Office.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" dist
cp target/release/herdr-app "$app/Contents/MacOS/AIOffice"
cp assets/icons/AIOffice.icns "$app/Contents/Resources/AIOffice.icns"
cp LICENSE THIRD-PARTY-NOTICES NOTICE.md "$app/Contents/Resources/"
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>AIOffice</string>
    <key>CFBundleIdentifier</key><string>io.github.brad-cat.ai-office</string>
    <key>CFBundleName</key><string>AI Office</string>
    <key>CFBundleDisplayName</key><string>AI Office</string>
    <key>CFBundleIconFile</key><string>AIOffice</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$version</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in AI Office can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in AI Office can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in AI Office can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict/></dict></plist>
PLIST
codesign --force --deep --sign - "$app"
out="dist/AI-Office-macos-$arch.zip"
rm -f "$out"
ditto -c -k --keepParent "$app" "$out"
echo "package: $out ($version)"
